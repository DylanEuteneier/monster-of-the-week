  "cards": [
    {
      "id": "fresh-meat",
      "name": "Leave Out Fresh Meat",
      "suit": "nocturnals",
      "slot": "strike",
      "influence": 2,
      "action": "lure",
      "text": "The largest group adjacent to the target moves into it, all of it. Target: the bait location.",
      "readings": {
        "location": "a ◐ location, any faction comes.",
        "faction": "anywhere, only the Nocturnals come."
      }
    },
    {
      "id": "track-snow",
      "name": "Track Them in the Snow",
      "suit": "nocturnals",
      "slot": "shift",
      "influence": 3,
      "action": "sow",
      "text": "Drive the target group hex by bordering hex, leaving 1 cube and 1 of your influence in each location entered, while your influence with that faction lasts. A location it can't enter ends the chase; leftover cubes stay together at the last location. Target: the group chased.",
      "readings": {
        "location": "any group at a ◐ location.",
        "faction": "a Nocturnal group anywhere."
      }
    },
    {
      "id": "silver-bullets",
      "name": "Silver Bullets",
      "suit": "nocturnals",
      "slot": "signature",
      "influence": 4,
      "action": "token",
      "text": "Hidden: at its fight, each group loses 2 more cubes as casualties.",
      "readings": {
        "location": "a ◐ location.",
        "faction": "a location holding the Nocturnals."
      },
      "response": {
        "id": "never-invite",
        "name": "Never Invite Them In",
        "timing": "before",
        "trigger": "move-into-your-location",
        "text": "When a player is about to move cubes into a location where you have influence, block it; the cubes stay where they are."
      }
    },
    {
      "id": "broadcast",
      "name": "Broadcast a Signal",
      "suit": "scifi",
      "slot": "strike",
      "influence": 2,
      "action": "broadcast",
      "text": "Call the groups of one faction from up to two locations anywhere into the target. Target: where they answer.",
      "readings": {
        "location": "any faction, into an ↂ location.",
        "faction": "the Sci-Fi faction, into any location."
      }
    },
    {
      "id": "leak",
      "name": "Leak the Documents",
      "suit": "scifi",
      "slot": "shift",
      "influence": 3,
      "action": "halve",
      "text": "Half the target group, rounded down, leaves for an adjacent location of your choice. Target: the group split.",
      "readings": {
        "location": "any group at an ↂ location.",
        "faction": "a Sci-Fi group anywhere."
      }
    },
    {
      "id": "beam",
      "name": "Beam Them Up",
      "suit": "scifi",
      "slot": "signature",
      "influence": 4,
      "action": "teleport",
