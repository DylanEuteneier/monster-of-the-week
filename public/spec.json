      "readings": {
        "location": "any group at an ↂ location.",
        "faction": "a Sci-Fi group anywhere."
      },
      "response": {
        "id": "classified",
        "name": "Classified",
        "timing": "after",
        "trigger": "token-placed",
        "text": "When a hidden token is placed, look at its face."
      }
    },
    {
      "id": "virus",
